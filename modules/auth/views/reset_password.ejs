<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password - Telegram Booster</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: Arial, sans-serif; background: #f5f5f5; display: flex; justify-content: center; align-items: center; min-height: 100vh; }
    .auth-container { max-width: 400px; width: 100%; margin: 20px; padding: 40px; background: white; border-radius: 12px; box-shadow: 0 2px 20px rgba(0,0,0,0.1); }
    .auth-header { text-align: center; margin-bottom: 30px; }
    .auth-header h2 { font-size: 24px; color: #333; }
    .auth-header p { color: #666; margin-top: 8px; }
    .form-group { margin-bottom: 20px; }
    .form-group label { display: block; margin-bottom: 6px; font-weight: 600; color: #333; font-size: 14px; }
    .form-group input { width: 100%; padding: 12px 16px; border: 1px solid #ddd; border-radius: 8px; font-size: 15px; }
    .form-group input:focus { outline: none; border-color: #28a745; }
    .auth-btn { width: 100%; padding: 14px; background: #28a745; color: white; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; transition: background 0.2s; }
    .auth-btn:hover { background: #218838; }
    .auth-btn:disabled { background: #999; cursor: not-allowed; }
    .auth-link { text-align: center; color: #666; margin-top: 16px; }
    .auth-link a { color: #007bff; text-decoration: none; font-size: 14px; }
    .auth-link a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <div class="auth-container">
    <% if (typeof tokenValid !== 'undefined' && !tokenValid) { %>
      <div class="auth-header">
        <h2>Link Tidak Valid</h2>
      </div>
      <div style="text-align: center; padding: 20px 0;">
        <p style="color: #dc3545; margin-bottom: 16px;"><%= error || 'Link reset password tidak valid atau sudah kedaluwarsa.' %></p>
        <p style="color: #666; margin-bottom: 20px;">Silakan minta link reset password baru melalui halaman lupa password.</p>
        <a href="/forgot-password" style="display: inline-block; padding: 12px 30px; background: #007bff; color: white; border-radius: 8px; text-decoration: none; font-weight: 600;">Lupa Password</a>
      </div>
      <div class="auth-link">
        <a href="/login">Kembali ke Login</a>
      </div>
    <% } else { %>
      <div class="auth-header">
        <h2>Reset Password</h2>
        <p>Masukkan password baru Anda</p>
      </div>
      <form id="resetForm">
        <div class="form-group">
          <label for="password">Password Baru</label>
          <input type="password" id="password" name="password" placeholder="Masukkan password baru" minlength="4" required>
        </div>
        <div class="form-group">
          <label for="confirmPassword">Konfirmasi Password</label>
          <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Ketik ulang password" required>
        </div>
        <button type="submit" class="auth-btn" id="submitBtn">Reset Password</button>
        <div id="message" style="display: none; text-align: center; margin-top: 16px; padding: 12px; border-radius: 8px;"></div>
      </form>
      <div class="auth-link">
        <a href="/login">Kembali ke Login</a>
      </div>
    <% } %>
  </div>
  <script>
    document.getElementById('resetForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const password = document.getElementById('password').value;
      const confirm = document.getElementById('confirmPassword').value;
      const msg = document.getElementById('message');
      const btn = document.getElementById('submitBtn');
      msg.style.display = 'none';
      if (password !== confirm) {
        msg.style.display = 'block'; msg.style.background = '#f8d7da'; msg.style.color = '#721c24';
        msg.textContent = 'Password tidak sama!'; return;
      }
      btn.disabled = true; btn.textContent = 'Menyimpan...';
      try {
        const response = await fetch('/process_reset_password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token: '<%= token %>', password }),
          credentials: 'include'
        });
        const data = await response.json();
        if (data.status === 'success') {
          msg.style.display = 'block'; msg.style.background = '#d4edda'; msg.style.color = '#155724';
          msg.textContent = 'Password berhasil direset! Silakan login.';
          btn.disabled = true; btn.textContent = 'Berhasil!';
          setTimeout(() => { window.location.href = '/login'; }, 2000);
        } else {
          msg.style.display = 'block'; msg.style.background = '#f8d7da'; msg.style.color = '#721c24';
          msg.textContent = data.message || 'Gagal mereset password';
          btn.disabled = false; btn.textContent = 'Reset Password';
        }
      } catch (error) {
        msg.style.display = 'block'; msg.style.background = '#f8d7da'; msg.style.color = '#721c24';
        msg.textContent = 'Terjadi kesalahan. Silakan coba lagi.';
        btn.disabled = false; btn.textContent = 'Reset Password';
      }
    });
  </script>
</body>
</html>
